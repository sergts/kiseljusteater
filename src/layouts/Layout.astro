---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { LOCALES, type Locale } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const {
  title = 'Kiseljus Teater | Tallinn, Lootsi 8',
  description = 'Kiseljus Teater - Sõltumatu ja kaasaegne teater Tallinnas. Mängukava, lavastused ja piletid.',
  lang = (Astro.currentLocale as Locale) || 'et',
} = Astro.props;

const currentPath = Astro.url.pathname;
// / serves the Estonian home page, so its canonical address is /et/.
const rest = currentPath.replace(/^\/(et|ru|en)(?=\/|$)/, '') || '/';
const pathFor = (code: Locale) => new URL(`/${code}${rest}`, Astro.site ?? Astro.url).href;
const ogLocale = { et: 'et_EE', ru: 'ru_RU', en: 'en_GB' }[lang];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <link rel="canonical" href={pathFor(lang)} />
    {LOCALES.map((code) => <link rel="alternate" hreflang={code} href={pathFor(code)} />)}
  </head>
  <body class="min-h-screen flex flex-col bg-white text-zinc-900 antialiased selection:bg-red-600 selection:text-white">
    <Header lang={lang} currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
