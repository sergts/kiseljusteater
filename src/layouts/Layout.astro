---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Locale } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const {
  title = 'Kiseljus Teater | Tallinn, Lootsi 8',
  description = 'Kiseljus Teater - Sõltumatu ja kaasaegne teater Tallinnas. Mängukava, lavastused ja piletid.',
  lang = (Astro.currentLocale as Locale) || 'et',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'et_EE'} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-zinc-900 antialiased selection:bg-red-600 selection:text-white">
    <Header lang={lang} currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
