---
import { tr, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
  href: string;
}
const { lang, href } = Astro.props;
---

<!-- Phones only: the buy button stays within reach once the visitor has scrolled past the first screen. -->
<div data-buybar class="md:hidden fixed inset-x-0 bottom-0 z-40 bg-black/95 backdrop-blur border-t border-zinc-800 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
  <a
    href={href}
    class="block w-full text-center bg-red-600 hover:bg-red-700 text-white font-mono text-sm font-bold uppercase tracking-widest py-3.5"
  >
    {tr(lang, 'Osta pilet', 'Купить билет', 'Buy tickets')} →
  </a>
</div>

<script>
  let onScroll: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    const bar = document.querySelector<HTMLElement>('[data-buybar]');
    if (onScroll) window.removeEventListener('scroll', onScroll);
    if (!bar) return;
    onScroll = () => {
      bar.dataset.visible = String(window.scrollY > 320);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>
