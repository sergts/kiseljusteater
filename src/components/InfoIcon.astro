---
/** Small line icons for the information blocks (the admin picks the name). */
interface Props {
  name?: string;
  class?: string;
}
const { name = 'info', class: className = 'w-5 h-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'clock' && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>)}
  {name === 'access' && (<><circle cx="11" cy="4.5" r="1.5" /><path d="M11 7.5v6h5l2 5" /><path d="M8.2 10.8A5.5 5.5 0 1 0 15.5 19" /></>)}
  {name === 'ticket' && (<><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1.5a1.5 1.5 0 0 0 0 3V15a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1.5a1.5 1.5 0 0 0 0-3z" /><path d="M14 7v10" stroke-dasharray="2 2" /></>)}
  {name === 'flower' && (<><circle cx="12" cy="8" r="2.5" /><path d="M12 5.5c0-2 1.5-3 3-3 0 1.5-1 3-3 3zM12 5.5c0-2-1.5-3-3-3 0 1.5 1 3 3 3zM9.5 8c-2 0-3 1.5-3 3 1.5 0 3-1 3-3zM14.5 8c2 0 3 1.5 3 3-1.5 0-3-1-3-3z" /><path d="M12 10.5V21M12 16c2-2 4-2 6-1" /></>)}
  {name === 'coffee' && (<><path d="M5 9h11v5a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4V9z" /><path d="M16 10.5h2a2 2 0 0 1 0 4h-2M8 4v2M12 4v2" /></>)}
  {!['clock', 'access', 'ticket', 'flower', 'coffee'].includes(name) && (<><circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><circle cx="12" cy="8" r="0.6" fill="currentColor" /></>)}
</svg>
