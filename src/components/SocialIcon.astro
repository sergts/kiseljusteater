---
/** Instagram and Facebook marks for the social links. */
interface Props {
  name: 'instagram' | 'facebook';
  class?: string;
}
const { name, class: className = 'w-5 h-5' } = Astro.props;
---

{name === 'instagram' && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.5" cy="6.5" r="0.7" fill="currentColor" stroke="none" />
  </svg>
)}
{name === 'facebook' && (
  <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.6V3.4c-.3 0-1.2-.2-2.3-.2-2.4 0-4 1.4-4 4.1v2.5H7.7V13h2.7v8h3.1z" />
  </svg>
)}
