---
import { useTranslations, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="bg-zinc-950 text-white border-t border-zinc-800 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 border-b border-zinc-800 pb-12">
      
      <!-- Brand & Mission summary -->
      <div class="md:col-span-1 space-y-4">
        <span class="text-2xl font-black uppercase tracking-tighter text-white">
          Kiseljus Teater
        </span>
        <p class="font-mono text-xs text-zinc-400 leading-relaxed">
          {lang === 'ru' 
            ? 'Пространство бескомпромиссного драматического поиска и авторского театра у Таллиннского порта.' 
            : 'Kompromissitu draama ja kaasaegse lavakunsti autoriruum Tallinna sadamakvartalis.'}
        </p>
        <div class="pt-2">
          <span class="inline-block px-2.5 py-1 text-[10px] font-mono uppercase tracking-widest bg-zinc-900 border border-zinc-700 text-zinc-300">
            Hooaeg 2026 / 2027
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3 font-mono text-xs">
        <h3 class="text-white uppercase tracking-widest font-bold mb-4">// {lang === 'ru' ? 'Разделы' : 'Menüü'}</h3>
        <ul class="space-y-2">
          <li>
            <a href={`/${lang}/afisha`} class="text-zinc-400 hover:text-white transition-colors">
              → {t.nav.afisha}
            </a>
          </li>
          <li>
            <a href={`/${lang}/plays`} class="text-zinc-400 hover:text-white transition-colors">
              → {t.nav.plays}
            </a>
          </li>
          <li>
            <a href={`/${lang}/actors`} class="text-zinc-400 hover:text-white transition-colors">
              → {t.nav.actors}
            </a>
          </li>
          <li>
            <a href={`/${lang}/about`} class="text-zinc-400 hover:text-white transition-colors">
              → {t.nav.about}
            </a>
          </li>
        </ul>
      </div>

      <!-- Tickets & Partners -->
      <div class="space-y-3 font-mono text-xs">
        <h3 class="text-white uppercase tracking-widest font-bold mb-4">// {lang === 'ru' ? 'Билеты только онлайн' : 'Piletid ainult veebis'}</h3>
        <p class="text-zinc-400 text-xs leading-relaxed">
          {lang === 'ru'
            ? 'Билеты на все спектакли продаются исключительно онлайн в Piletikeskus (piletikeskus.ee). В самом театре билеты не продаются.'
            : 'Piletid kõigile etendustele on müügil AINULT VEEBIS Piletikeskuses (piletikeskus.ee). Teatris kohapeal piletimüüki ei toimu.'}
        </p>
        <a 
          href="https://piletikeskus.ee" 
          target="_blank" 
          rel="noreferrer" 
          class="inline-block text-red-500 hover:text-red-400 font-bold uppercase tracking-wider"
        >
          piletikeskus.ee ↗
        </a>
      </div>

      <!-- Location & Contact -->
      <div class="space-y-3 font-mono text-xs">
        <h3 class="text-white uppercase tracking-widest font-bold mb-4">// {lang === 'ru' ? 'Контакты' : 'Kontakt'}</h3>
        <p class="text-zinc-300 font-bold">{t.footer.address}</p>
        <p class="text-zinc-400">{t.footer.phone}</p>
        <p>
          <a href={`mailto:${t.footer.email}`} class="text-zinc-400 hover:text-white transition-colors">
            {t.footer.email}
          </a>
        </p>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-xs font-mono text-zinc-500 gap-4">
      <div>
        © {currentYear} Kiseljus Teater MTÜ. {t.footer.rights}
      </div>
      <div class="flex items-center space-x-6">
        <a href="/admin/" class="text-zinc-600 hover:text-zinc-400 transition-colors">
          {t.footer.adminLink}
        </a>
        <span>ESTONIA / TALLINN</span>
      </div>
    </div>
  </div>
</footer>
