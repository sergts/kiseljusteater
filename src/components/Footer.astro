---
import { contacts, field } from '../utils/content';
import SocialIcon from './SocialIcon.astro';
import { SHOW_ABOUT } from '../utils/site';
import { tr, useTranslations, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="bg-zinc-950 text-white border-t border-zinc-800 mt-20 pb-20 md:pb-0">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 border-b border-zinc-800 pb-12">
      
      <!-- Brand & Mission summary -->
      <div class="md:col-span-1 space-y-4">
        <img
          src="/images/logo/logo-white-arrow.svg"
          alt="Kiseljus Teater"
          width="309"
          height="83"
          class="h-10 w-auto"
        />
        <p class="font-mono text-xs text-zinc-400 leading-relaxed">
          {tr(lang, 'Kompromissitu draama ja kaasaegse lavakunsti autoriruum Tallinna sadamakvartalis.', 'Пространство бескомпромиссного драматического поиска и авторского театра у Таллиннского порта.', 'A space for uncompromising dramatic exploration and author-driven theatre by the Tallinn port.')}
        </p>
        <div class="pt-2">
          <span class="inline-block px-2.5 py-1 text-xs font-mono uppercase tracking-widest bg-zinc-900 border border-zinc-700 text-zinc-300">
            Hooaeg 2026 / 2027
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3 font-mono text-xs">
        <h3 class="text-white uppercase tracking-widest font-bold mb-4">{tr(lang, 'Menüü', 'Разделы', 'Menu')}</h3>
        <ul class="space-y-2">
          <li>
            <a href={`/${lang}/afisha/`} class="inline-block py-1 text-zinc-400 hover:text-white transition-colors">
              → {t.nav.afisha}
            </a>
          </li>
          <li>
            <a href={`/${lang}/plays/`} class="inline-block py-1 text-zinc-400 hover:text-white transition-colors">
              → {t.nav.plays}
            </a>
          </li>
          <li>
            <a href={`/${lang}/actors/`} class="inline-block py-1 text-zinc-400 hover:text-white transition-colors">
              → {t.nav.actors}
            </a>
          </li>
          {SHOW_ABOUT && (
            <li>
              <a href={`/${lang}/about/`} class="inline-block py-1 text-zinc-400 hover:text-white transition-colors">
                → {t.nav.about}
              </a>
            </li>
          )}
        </ul>
      </div>

      <!-- Tickets & Partners -->
      <div class="space-y-3 font-mono text-xs">
        <h3 class="text-white uppercase tracking-widest font-bold mb-4">{tr(lang, 'Piletid ainult veebis', 'Билеты только онлайн', 'Tickets online only')}</h3>
        <p class="text-zinc-400 text-xs leading-relaxed">
          {tr(lang, 'Piletid kõigile etendustele on müügil AINULT VEEBIS Piletikeskuses (piletikeskus.ee). Teatris kohapeal piletimüüki ei toimu.', 'Билеты на все спектакли продаются исключительно онлайн в Piletikeskus (piletikeskus.ee). В самом театре билеты не продаются.', 'Tickets for all performances are sold exclusively online through Piletikeskus (piletikeskus.ee). No tickets are sold at the theatre itself.')}
        </p>
        {contacts.tickets_url && (
          <a
            href={contacts.tickets_url}
            target="_blank"
            rel="noreferrer"
            class="inline-block py-1 text-red-400 hover:text-white font-bold uppercase tracking-wider"
          >
            piletikeskus.ee ↗
          </a>
        )}
      </div>

      <!-- Location & Contact -->
      <div class="space-y-3 font-mono text-xs">
        <h3 class="text-white uppercase tracking-widest font-bold mb-4">{tr(lang, 'Kontakt', 'Контакты', 'Contact')}</h3>
        <p class="text-zinc-300 font-bold">{field(contacts, 'address', lang)}</p>
        <p class="text-zinc-400">{contacts.phone}</p>
        <p>
          <a href={`mailto:${contacts.email}`} class="inline-block py-1 text-zinc-400 hover:text-white transition-colors">
            {contacts.email}
          </a>
        </p>
        {(contacts.instagram || contacts.facebook) && (
          <p class="flex flex-wrap items-center gap-x-5 pt-1">
            {contacts.instagram && (
              <a href={contacts.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 py-2 text-zinc-400 hover:text-white transition-colors">
                <SocialIcon name="instagram" /> Instagram
              </a>
            )}
            {contacts.facebook && (
              <a href={contacts.facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 py-2 text-zinc-400 hover:text-white transition-colors">
                <SocialIcon name="facebook" /> Facebook
              </a>
            )}
          </p>
        )}
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row justify-end items-center text-xs font-mono text-zinc-400 gap-4">
      <span>ESTONIA / TALLINN</span>
    </div>
  </div>
</footer>
