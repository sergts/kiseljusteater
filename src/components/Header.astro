---
import { LOCALES, useTranslations, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
  currentPath?: string;
}

const { lang, currentPath = '' } = Astro.props;
const t = useTranslations(lang);

// Same page in another language. The root page (/) is the Estonian home page.
const rest = currentPath.replace(/^\/(et|ru|en)(?=\/|$)/, '') || '/';
const pathFor = (target: Locale) => `/${target}${rest}`;

const navLinks = [
  { href: `/${lang}/afisha/`, label: t.nav.afisha },
  { href: `/${lang}/plays/`, label: t.nav.plays },
  { href: `/${lang}/actors/`, label: t.nav.actors },
  { href: `/${lang}/about/`, label: t.nav.about },
];

const isLinkActive = (href: string) => {
  if (currentPath === href || (href !== `/${lang}/` && currentPath.startsWith(href))) {
    return true;
  }
  return false;
};
---

<header data-header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="header-inner flex items-center justify-between">
      
      <!-- Logo / Title -->
      <a href={`/${lang}/`} class="flex items-center py-2" aria-label="Kiseljus Teater">
        <img
          src="/images/logo/logo-black-arrow.svg"
          alt="Kiseljus Teater"
          width="309"
          height="83"
          class="header-logo h-9 sm:h-11 w-auto"
        />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`text-xs font-mono uppercase tracking-widest transition-colors ${
              isLinkActive(link.href)
                ? 'text-red-600 font-bold border-b-2 border-red-600 pb-1'
                : 'text-zinc-600 hover:text-black'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right CTAs & Language Switcher -->
      <div class="flex items-center space-x-4 sm:space-x-6">
        <!-- Language Switcher -->
        <div class="flex items-center border border-zinc-200 p-0.5 text-xs font-mono uppercase">
          {LOCALES.map((code) => (
            <a
              href={code === lang ? '#' : pathFor(code)}
              class={`inline-flex items-center justify-center min-w-[2.75rem] h-10 px-2 sm:min-w-0 sm:h-8 sm:px-2.5 transition-colors ${
                code === lang
                  ? 'bg-black text-white font-bold'
                  : 'text-zinc-500 hover:text-black'
              }`}
              aria-current={code === lang ? 'page' : undefined}
              hreflang={code}
            >
              {code}
            </a>
          ))}
        </div>

        <!-- Quick Ticket CTA -->
        <a
          href={`/${lang}/afisha/`}
          class="hidden sm:inline-block bg-red-600 hover:bg-red-700 text-white text-xs font-mono font-bold uppercase tracking-wider px-5 py-2.5 transition-colors"
        >
          {t.nav.buyTickets}
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-button"
          type="button"
          aria-label="Toggle Navigation Menu"
          class="md:hidden p-2 text-black hover:text-red-600 focus:outline-none"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon-bars" stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-icon-close" class="hidden" stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-zinc-200 bg-white px-4 pt-4 pb-6 space-y-4">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block text-sm font-mono uppercase tracking-widest py-2 border-b border-zinc-100 ${
          isLinkActive(link.href) ? 'text-red-600 font-bold' : 'text-zinc-700'
        }`}
      >
        {link.label}
      </a>
    ))}
    <div class="pt-2">
      <a
        href={`/${lang}/afisha/`}
        class="block text-center w-full bg-red-600 text-white text-xs font-mono font-bold uppercase tracking-wider py-3"
      >
        {t.nav.buyTickets}
      </a>
    </div>
  </div>
</header>

<script>
  // Runs after every page load, including navigations done by the page-transition router.
  let onScroll: (() => void) | null = null;

  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const iconBars = document.getElementById('menu-icon-bars');
    const iconClose = document.getElementById('menu-icon-close');

    if (btn && menu && iconBars && iconClose) {
      btn.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        iconBars.classList.toggle('hidden', open);
        iconClose.classList.toggle('hidden', !open);
        if (header && open) header.dataset.hidden = 'false';
      });
    }

    if (onScroll) window.removeEventListener('scroll', onScroll);
    if (!header) return;

    // Tell sticky elements below the header (e.g. the afisha month bar) where its lower edge is.
    const publishOffset = () => {
      const offset = header.dataset.hidden === 'true' ? 0 : header.offsetHeight;
      document.documentElement.style.setProperty('--header-offset', `${offset}px`);
    };
    new ResizeObserver(publishOffset).observe(header);

    let last = window.scrollY;
    onScroll = () => {
      const y = window.scrollY;
      const menuOpen = !!menu && !menu.classList.contains('hidden');
      header.dataset.scrolled = String(y > 16);
      if (menuOpen || y <= 160) header.dataset.hidden = 'false';
      else if (y > last + 6) header.dataset.hidden = String(window.innerWidth < 768); // hides on phones only
      else if (y < last - 6) header.dataset.hidden = 'false';
      last = y;
      publishOffset();
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
