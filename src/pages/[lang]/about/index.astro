---
import Layout from '../../../layouts/Layout.astro';
import { contacts, field } from '../../../utils/content';
import SocialIcon from '../../../components/SocialIcon.astro';
import { LOCALES, tr, useTranslations, type Locale } from '../../../utils/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  title={`${t.about.title} | Kiseljus Teater`}
  description={t.about.subtitle}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <!-- Header Banner -->
    <div class="border-b border-zinc-200 pb-8 mb-12">
      <p class="text-xs font-mono uppercase tracking-widest text-red-600 font-bold mb-2">
        {tr(lang, 'Teatrist ja ruumist', 'О театре и пространстве', 'About the theatre and the space')}
      </p>
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight mb-4">
        {t.about.title}
      </h1>
      <p class="text-zinc-600 font-mono text-sm max-w-2xl">
        {t.about.subtitle}
      </p>
    </div>

    <!-- Manifesto Section -->
    <section class="mb-16">
      <div class="border border-zinc-200 bg-zinc-50 p-6 sm:p-10">
        <span class="text-xs font-mono uppercase tracking-widest text-red-600 font-bold block mb-4">
          {t.about.missionTitle}
        </span>
        <blockquote class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-zinc-900 leading-snug mb-6">
          "{tr(lang, 'Teater ei ole koht mugavaks uinakuks. See on ausa dialoogi ja vahetu kohtumise ruum.', 'Театр не место для комфортного сна. Это место честного удара и искренней встречи.', 'Theatre is not a place for a comfortable nap. It is a space for honest dialogue and direct encounter.')}"
        </blockquote>
        <p class="text-zinc-700 leading-relaxed text-base sm:text-lg">
          {t.about.missionText}
        </p>
      </div>
    </section>

    <!-- The Space & Architecture (SINGLE HALL) -->
    <section class="mb-16 max-w-3xl">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-bold block mb-3">
          {tr(lang, 'Arhitektuur ja saal', 'Архитектура и пространство', 'Architecture and space')}
        </span>
        <h2 class="text-3xl font-black uppercase tracking-tight mb-4">
          {t.about.spaceTitle}
        </h2>
        <p class="text-zinc-700 leading-relaxed text-sm sm:text-base mb-6">
          {t.about.spaceText}
        </p>
        <div class="space-y-3 font-mono text-xs text-zinc-600 border-t border-zinc-200 pt-4">
          <div class="flex justify-between py-1 border-b border-zinc-100">
            <span class="font-bold text-black">{tr(lang, 'Teatrisaal', 'Зрительный зал', 'Auditorium')}</span>
            <span>{tr(lang, 'Üks saal-transformer', 'Один трансформируемый зал', 'One transformable hall')}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-zinc-100">
            <span class="font-bold text-black">{tr(lang, 'Ruumikontseptsioon', 'Пространство', 'Space concept')}</span>
            <span>{tr(lang, 'Valge stuudioruum', 'Светлый зал с верхним светом', 'A bright hall with overhead light')}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-zinc-100">
            <span class="font-bold text-black">{tr(lang, 'Piletite müük', 'Продажа билетов', 'Ticket sales')}</span>
            <span class="text-red-600 font-bold">{tr(lang, 'AINULT VEEBIS', 'ТОЛЬКО ОНЛАЙН', 'ONLINE ONLY')}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacts & Location Grid -->
    <section class="border-t border-zinc-200 pt-12">
      <h2 class="text-2xl font-black uppercase tracking-tight mb-8">
        {t.about.contactsTitle}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Address & Transit -->
        <div class="border border-zinc-200 p-6 bg-zinc-50">
          <h3 class="font-bold uppercase tracking-wider text-xs font-mono text-red-600 mb-3">
            {tr(lang, 'Aadress ja ligipääs', 'Адрес и транспорт', 'Address and getting here')}
          </h3>
          <p class="font-bold text-zinc-900 text-base mb-1">{field(contacts, 'address', lang)}</p>
          <p class="text-xs text-zinc-600 leading-relaxed font-mono mt-3">
            {tr(lang, 'Trammid nr 1 ja nr 2 (peatus "Tallinna Sadam"). Sadamakvartal Lootsi, D-terminali lähedal.', 'Трамваи №1 и №2 (остановка «Tallinna Sadam»). Портовый квартал Lootsi, рядом с D-терминалом.', 'Trams no. 1 and no. 2 (stop “Tallinna Sadam”). The Lootsi port quarter, near the D-Terminal.')}
          </p>
        </div>

        <!-- Online Tickets Policy (NO ONSITE CASH DESK) -->
        <div class="border border-zinc-200 p-6 bg-zinc-50">
          <h3 class="font-bold uppercase tracking-wider text-xs font-mono text-red-600 mb-3">
            {t.about.boxOffice}
          </h3>
          <p class="text-xs text-zinc-600 leading-relaxed font-mono mb-2">
            {t.about.boxOfficeInfo}
          </p>
          <p class="text-xs text-red-600 font-mono font-semibold">
            {tr(lang, 'Kohapeal piletikassat ei ole!', 'В театре кассы нет!', 'There is no box office at the theatre!')}
          </p>
          <div class="mt-4 pt-3 border-t border-zinc-200">
            <a
              href={`/${lang}/afisha/`}
              class="inline-block bg-black text-white px-4 py-2 text-xs font-mono uppercase tracking-wider hover:bg-red-600 transition-colors"
            >
              {tr(lang, 'Vaata mängukava', 'Перейти в афишу', 'See the schedule')} →
            </a>
          </div>
        </div>

        <!-- Inquiries -->
        <div class="border border-zinc-200 p-6 bg-zinc-50 font-mono text-xs">
          <h3 class="font-bold uppercase tracking-wider text-xs font-mono text-red-600 mb-3">
            {tr(lang, 'Side ja administratsioon', 'Связь и администрация', 'Contact and administration')}
          </h3>
          <p class="text-zinc-500 mb-1">{tr(lang, 'E-post:', 'Электронная почта:', 'Email:')}</p>
          <a href={`mailto:${contacts.email}`} class="text-black font-bold block mb-3 hover:text-red-600">
            {contacts.email}
          </a>
          <p class="text-zinc-500 mb-1">{tr(lang, 'Telefon:', 'Телефон:', 'Phone:')}</p>
          <a href={`tel:${contacts.phone.replace(/\s+/g, '')}`} class="text-black font-bold block mb-3 hover:text-red-600">
            {contacts.phone}
          </a>
          <p class="text-zinc-500 mb-1">{tr(lang, 'Kunstiline juht:', 'Художественный руководитель:', 'Artistic director:')}</p>
          <span class="text-zinc-800">Anton Kiseljus</span>
          {(contacts.instagram || contacts.facebook) && (
            <div class="mt-4 pt-3 border-t border-zinc-200">
              <p class="text-zinc-500 mb-1">{tr(lang, 'Sotsiaalmeedia:', 'Соцсети:', 'Social media:')}</p>
              {contacts.instagram && (
                <a href={contacts.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 py-2 mr-5 text-black font-bold hover:text-red-600">
                  <SocialIcon name="instagram" /> Instagram
                </a>
              )}
              {contacts.facebook && (
                <a href={contacts.facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 py-2 text-black font-bold hover:text-red-600">
                  <SocialIcon name="facebook" /> Facebook
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    </section>
  </div>
</Layout>
