---
import Layout from '../../../layouts/Layout.astro';
import PlayDates from '../../../components/PlayDates';
import { castOf, imageAttrs, plays, type Play } from '../../../utils/content';
import { useTranslations, type Locale } from '../../../utils/i18n';

export function getStaticPaths() {
  // Archived plays keep their pages so old links keep working.
  return (['et', 'ru'] as const).flatMap((lang) =>
    plays.map((play) => ({
      params: { lang, slug: play.slug },
      props: { play, lang },
    }))
  );
}

const { play, lang } = Astro.props as { play: Play; lang: Locale };
const t = useTranslations(lang);
const cast = castOf(play, lang);
const facts = [play.duration && `${play.duration} MIN`, play.age_limit, lang === 'ru' ? 'Сцена: Lootsi 8' : 'Lava: Lootsi 8'].filter(Boolean);
---

<Layout
  lang={lang}
  title={`${play[`title_${lang}`]} | Kiseljus Teater`}
  description={play[`synopsis_${lang}`]?.slice(0, 160)}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <!-- Breadcrumb -->
    <div class="font-mono text-xs uppercase tracking-widest text-zinc-500 mb-6 flex items-center space-x-2">
      <a href={`/${lang}`} class="hover:text-black">Kiseljus</a>
      <span>/</span>
      <a href={`/${lang}/plays`} class="hover:text-black">{lang === 'ru' ? 'Репертуар' : 'Repertuaar'}</a>
      <span>/</span>
      <span class="text-red-600 font-bold">{play[`title_${lang}`]}</span>
    </div>

    <!-- Hero / Stage Photo with gradient mask -->
    <div class="relative overflow-hidden mb-12 border border-zinc-200 bg-zinc-950">
      <img
        {...imageAttrs(play.poster, 'plays', '(min-width: 1024px) 1024px, 100vw')}
        alt={play[`title_${lang}`]}
        class="w-full h-80 sm:h-96 md:h-[480px] object-cover [mask-image:linear-gradient(to_bottom,black_70%,transparent_100%)] filter contrast-125"
      />
      <div class="absolute bottom-6 left-6 right-6">
        {play.archived && (
          <span class="inline-block bg-zinc-700 text-white font-mono text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 mb-2 mr-1">
            {t.plays.archived}
          </span>
        )}
        <span class="inline-block bg-red-600 text-white font-mono text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 mb-2">
          {play[`genre_${lang}`]}
        </span>
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-tighter text-white drop-shadow-md">
          {play[`title_${lang}`]}
        </h1>
        <p class="font-mono text-zinc-300 text-xs sm:text-sm mt-2">
          {facts.join(' · ')}
        </p>
      </div>
    </div>

    <!-- Upcoming Dates Module -->
    <section class="mt-12 border-t border-zinc-200 pt-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-bold">
          // {lang === 'ru' ? 'Следующие показы' : 'Järgmised etendused'}
        </h2>
        <a href={`/${lang}/afisha`} class="text-xs font-mono uppercase text-red-600 hover:underline">
          {lang === 'ru' ? 'Вся афиша →' : 'Kogu mängukava →'}
        </a>
      </div>

      <div class="divide-y divide-zinc-200 border-t border-b border-zinc-200">
        {play.archived ? (
          <p class="py-6 font-mono text-sm text-zinc-500 px-2">{t.plays.archivedNote}</p>
        ) : (
          <PlayDates client:load lang={lang} playSlug={play.slug} variant="list" />
        )}
      </div>
    </section>

    <!-- Synopsis -->
    <section class="mt-14 max-w-3xl">
      <h2 class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-bold mb-4">
        // {lang === 'ru' ? 'О спектакле' : 'Lavastusest'}
      </h2>
      <div class="text-zinc-800 text-base sm:text-lg leading-relaxed whitespace-pre-line space-y-4">
        {play[`synopsis_${lang}`]}
      </div>
    </section>

    <!-- Cast / Troupe -->
    <section class="mt-16 border-t border-zinc-200 pt-8">
      <h2 class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-bold mb-8">
        // {lang === 'ru' ? 'Действующие лица и исполнители' : 'Tegelased ja osatäitjad'}
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
        {cast.map(({ actor, role }) => (
          <a
            href={`/${lang}/actors/${actor.slug}`}
            class="group border border-zinc-200 p-4 bg-zinc-50/50 hover:bg-white hover:border-black transition-all"
          >
            <p class="font-bold uppercase text-sm group-hover:text-red-600 transition-colors">
              {actor[`name_${lang}`]}
            </p>
            <p class="text-xs font-mono text-zinc-500 mt-1">
              {role}
            </p>
            <span class="inline-block text-[11px] font-mono text-red-600 mt-3 group-hover:translate-x-1 transition-transform">
              →
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Bottom Navigation -->
    <div class="mt-16 pt-8 border-t border-zinc-200 flex justify-between items-center font-mono text-xs uppercase">
      <a href={`/${lang}/plays`} class="text-zinc-600 hover:text-black">
        ← {lang === 'ru' ? 'Назад в репертуар' : 'Tagasi repertuaari'}
      </a>
      <a href={`/${lang}/afisha`} class="text-red-600 font-bold hover:underline">
        {lang === 'ru' ? 'Смотреть афишу' : 'Vaata mängukava'} →
      </a>
    </div>
  </div>
</Layout>
