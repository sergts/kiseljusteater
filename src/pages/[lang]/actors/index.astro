---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../../layouts/Layout.astro';
import { useTranslations, type Locale } from '../../../utils/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'et' } },
    { params: { lang: 'ru' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const actors = JSON.parse(fs.readFileSync(path.resolve('./src/content/actors.json'), 'utf-8'));
const plays = JSON.parse(fs.readFileSync(path.resolve('./src/content/plays.json'), 'utf-8'));
---

<Layout
  lang={lang}
  title={`${t.actors.title} | Kiseljus Teater`}
  description={t.actors.subtitle}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <!-- Header Banner -->
    <div class="border-b border-zinc-200 pb-8 mb-12">
      <p class="text-xs font-mono uppercase tracking-widest text-red-600 font-bold mb-2">
        // {lang === 'ru' ? 'Актерский состав и руководство' : 'Näitlejad ja loovmeeskond'}
      </p>
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight mb-4">
        {t.actors.title}
      </h1>
      <p class="text-zinc-600 font-mono text-sm max-w-2xl">
        {t.actors.subtitle}
      </p>
    </div>

    <!-- Troupe Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
      {actors.map((actor: any) => {
        const actorPlays = plays.filter((p: any) =>
          p.cast?.some((c: any) => c.slug === actor.slug)
        );

        return (
          <div class="group border border-zinc-200 bg-white flex flex-col justify-between hover:border-black transition-all">
            <div>
              <div class="p-3 bg-zinc-50 border-b border-zinc-200">
                <div class="aspect-[3/4] overflow-hidden bg-zinc-200">
                  <img
                    src={actor.photo_url || "/images/placeholder-actor.jpg"}
                    alt={actor[`name_${lang}`]}
                    class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500"
                  />
                </div>
              </div>

              <div class="p-6">
                <p class="text-xs font-mono text-red-600 uppercase tracking-widest mb-1 font-semibold">
                  {actor[`role_title_${lang}`]}
                </p>
                <h2 class="text-2xl font-black uppercase tracking-tight mb-3 group-hover:text-red-600 transition-colors">
                  <a href={`/${lang}/actors/${actor.slug}`}>
                    {actor[`name_${lang}`]}
                  </a>
                </h2>
                <p class="text-zinc-600 text-sm leading-relaxed mb-6 line-clamp-3">
                  {actor[`bio_${lang}`]}
                </p>

                <!-- Active Roles -->
                <div class="border-t border-zinc-100 pt-4">
                  <p class="text-[10px] font-mono uppercase tracking-widest text-zinc-400 mb-2">
                    // {t.actors.repertoireRoles}:
                  </p>
                  <div class="space-y-1">
                    {actorPlays.slice(0, 3).map((p: any) => (
                      <div class="text-xs font-mono flex justify-between">
                        <span class="font-bold text-zinc-800">{p[`title_${lang}`]}</span>
                        <span class="text-zinc-400">
                          {p.cast.find((c: any) => c.slug === actor.slug)?.[`role_name_${lang}`]}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-zinc-100 flex items-center justify-end mt-4">
              <a
                href={`/${lang}/actors/${actor.slug}`}
                class="font-mono text-xs font-bold uppercase tracking-wider text-black hover:text-red-600 transition-colors"
              >
                {t.actors.viewProfile}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
